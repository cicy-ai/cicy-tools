{
  "manifest_version": 3,
  "name": "cicy-tools",
  "version": "1.2.2",
  "description": "Keeps supported Colab and Google Cloud Shell workspaces active.",
  "content_scripts": [
    {
      "matches": [
        "https://colab.research.google.com/*",
        "https://shell.cloud.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
