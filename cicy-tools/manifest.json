{
  "manifest_version": 3,
  "name": "cicy-tools",
  "version": "1.1.4",
  "description": "Periodically runs the cicy-tools heartbeat first cell in Colab.",
  "content_scripts": [
    {
      "matches": ["https://colab.research.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
